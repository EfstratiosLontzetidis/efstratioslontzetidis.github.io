---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Efstratios Lontzetidis - Cyber Threat Research</title>
    <description>Publications by Efstratios Lontzetidis.</description>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
    
    {% for article in site.data.articles %}
    <item>
      <title>{{ article.title | xml_escape }}</title>
      <description>Published by {{ article.publisher | xml_escape }}</description>
      <pubDate>{{ article.date | date: "%a, %d %b %Y %H:%M:%S %z" }}</pubDate>
      <link>{{ article.url }}</link>
      <guid isPermaLink="true">{{ article.url }}</guid>
    </item>
    {% endfor %}
    
  </channel>
</rss>
